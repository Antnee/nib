import std.codec.{Codable, DbCodec}

// Hashing passwords. Hashes are checked with `PasswordHash.verify`.

/// How new passwords are hashed. Changing the policy never breaks existing hashes: they
/// still verify, and `verify` says when one should be replaced.
pub record Policy {
	/// The library's current recommendation (Argon2id today). It may change in a later
	/// release; hashes made under an older one still verify.
	const RECOMMENDED: Policy

	/// A policy that hashes with `scheme`.
	///
	/// ```
	/// let policy = passwords.Policy.using(Argon2idScheme.params(memoryKib: 65536, iterations: 3))
	/// ```
	static fn using(scheme: PasswordScheme) -> Policy

	/// The algorithm new hashes are made with.
	get algorithm: PasswordAlgorithm
}

/// Hashes `password` with the recommended policy. Deliberately slow.
pub fn hash(password: Sensitive) -> PasswordHash

/// Hashes `password` with `policy`. Deliberately slow.
pub fn hash(password: Sensitive, policy: Policy) -> PasswordHash

/// Takes as long as verifying a password under the recommended policy, and does nothing
/// else. Call it when there is no account to check, so the response time doesn't reveal
/// which accounts exist.
pub fn simulateVerify()

/// Takes as long as verifying a password under `policy`, and does nothing else.
pub fn simulateVerify(policy: Policy)

// ---------------------------------------------------------------------------------------
// Password hashes

/// A stored password hash. Reads the PHC strings this library writes and legacy formats
/// (`$2y$` bcrypt from PHP, `$argon2id$`, scrypt, PBKDF2), so imported user tables verify.
///
/// It is stored in the database as its `text` and read back through `parse`. It can't be
/// written as JSON or form data, so a hash can't be sent out by mistake.
pub record PasswordHash implements Codable<DbCodec> {
	/// Reads a stored hash.
	static fn parse(text: String) -> PasswordHash else PasswordHashError

	/// The hash in the form to store.
	get text: String

	/// The algorithm that made this hash.
	get algorithm: PasswordAlgorithm

	/// Checks `attempt` against the hash. Says `ValidNeedsRehash` when the password is right
	/// but the hash doesn't match `policy`, so the caller can store a fresh one.
	///
	/// ```
	/// let check = stored.verify(attempt, policy)
	/// if check is PasswordCheck.ValidNeedsRehash {
	/// 	let fresh = passwords.hash(attempt, policy)
	/// }
	/// ```
	fn verify(attempt: Sensitive, policy: Policy) -> PasswordCheck

	/// Checks `attempt` against the hash, comparing with the recommended policy.
	fn verify(attempt: Sensitive) -> PasswordCheck
}

/// The answer from `PasswordHash.verify`.
pub enum PasswordCheck {
	/// The password is right and the hash is up to date.
	Valid

	/// The password is wrong.
	Invalid

	/// The password is right, but the hash uses another algorithm or other parameters than
	/// the policy. Hash the password again and store the new hash.
	ValidNeedsRehash
}

/// Why a stored hash couldn't be read.
pub enum PasswordHashError implements Error {
	/// It isn't in any format this library knows.
	UnknownFormat

	/// It looks like a known format but is damaged.
	Malformed

	override get message: String
}

/// The algorithms a password hash can have been made with. New hashes use only Argon2id
/// or bcrypt; the others are read so that imported hashes verify.
pub enum PasswordAlgorithm {
	Argon2id
	Bcrypt
	Scrypt
	Pbkdf2
}

/// An algorithm with its parameters, for building a `Policy`. Implemented by
/// `Argon2idScheme` and `BcryptScheme`.
pub interface PasswordScheme {
	/// Which algorithm this is.
	get algorithm: PasswordAlgorithm
}

/// Argon2id with chosen parameters. The recommended algorithm.
///
/// ```
/// let policy = passwords.Policy.using(Argon2idScheme.params(memoryKib: 65536, iterations: 3))
/// ```
pub record Argon2idScheme implements PasswordScheme {
	/// Argon2id using `memoryKib` kibibytes of memory and `iterations` passes.
	static fn params(named memoryKib: Int, named iterations: Int) -> Argon2idScheme

	override get algorithm: PasswordAlgorithm
}

/// Bcrypt with a chosen cost, for apps that must keep writing bcrypt hashes.
pub record BcryptScheme implements PasswordScheme {
	/// Bcrypt with `2^rounds` iterations. Panics unless `rounds` is from 4 to 31.
	static fn cost(rounds: Int) -> BcryptScheme

	override get algorithm: PasswordAlgorithm
}

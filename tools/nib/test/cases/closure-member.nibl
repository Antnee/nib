// expect: error: `Line` has no member `isShrot`; did you mean `isShort`?
type Sku: String

record Line {
	sku: Sku
	quantity: Int
	isShort: Bool
}

enum QuoteError implements Error {
	Unavailable

	override get message: String => "no quote"
}

fn quote(line: Line) -> Int else QuoteError {
	return line.quantity
}

fn run(lines: List<Line>) -> List<Line> {
	return lines.filter(fn(line) => line.isShrot)
}

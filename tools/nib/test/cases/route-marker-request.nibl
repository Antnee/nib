// expect: error: `home`'s first parameter, `req`, is the request, which isn't marked
// The request always comes first, so it needs no marker.
import std.http.{@guard, @path, Method, Request, Response, Route, Routes, ToResponse}

type ShopId: Int implements Parseable
type OrderId: Int implements Parseable

enum WebError implements ToResponse {
	NotFound

	override get message: String => "not found"

	override fn toResponse() -> Response {
		return Response.notFound()
	}
}

record User {
	name: String
}

record Shop {
	id: ShopId
}

class Guards {
	fn user(req: Request) -> User else WebError {
		fail WebError.NotFound
	}

	fn shop(req: Request, @guard user: User, @path shopId: ShopId) -> Shop else WebError {
		fail WebError.NotFound
	}
}

class Pages {
	fn home(@path req: Request) -> Response {
		return Response.notFound()
	}

	fn order(req: Request, @guard shop: Shop, @path orderId: OrderId) -> Response else WebError {
		return Response.notFound()
	}

	fn account(req: Request, @guard user: User) -> Response else WebError {
		return Response.notFound()
	}

	fn file(req: Request, @path path: String) -> Response {
		return Response.notFound()
	}
}

class Services {
	guards: Guards
	pages: Pages
}

fn routes() -> Routes<Services> {
	return Routes(
		routes: [
			Route.get("/", fn(app) => app.pages.home),
			Route.on("/files/{path...}", fn(app) => app.pages.file, methods: [Method.Get, Method.Head]),
			Route.group(requiring: fn(app) => app.guards.user, routes: [
				Route.get("/account", fn(app) => app.pages.account),
				Route.group(prefix: "/shops/{shopId}", requiring: fn(app) => app.guards.shop, routes: [
					Route.get("/orders/{orderId}", fn(app) => app.pages.order),
				]),
			]),
		],
	)
}

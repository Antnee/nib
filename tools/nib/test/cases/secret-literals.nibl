// expect: ok
import std.html.{Html}
import std.http.{RelativeUrl, Url}

@sensitive
type Token: private String

fn header(token: Token) -> Secret {
	return secret"Bearer ${token}"
}

fn confirmPath(token: Token) -> Secret<RelativeUrl> {
	return secret url"confirm?token=${token}"
}

fn confirmLink(base: Url, token: Token) -> Secret<Url> {
	return base.join(url"confirm", secretQuery: ["token": token])
}

fn button(link: Secret<Url>, label: String) -> Secret<Html> {
	return secret html"<a href=\"${link}\">${label}</a>"
}

fn body(link: Secret<Url>) -> Secret {
	return secret"Confirm your email address: ${link}"
}
